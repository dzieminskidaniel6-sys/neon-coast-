; NEON COAST — Godot 4 low-poly 3D remake
config_version=5

[application]
config/name="NEON COAST: The Lost Signal"
run/max_fps=60
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540

[rendering]
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)
lights_and_shadows/use_shadow_atlas=false

[physics]
3d/default_gravity=18.0

