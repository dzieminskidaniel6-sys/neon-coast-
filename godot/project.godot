; NEON COAST — Godot 4 low-poly 3D remake
config_version=5

[application]
config/name="NEON COAST: The Lost Signal"
config/description="A coastal story adventure about a missing signal."
config/version="0.2.0"
config/icon="res://assets/app_icon.svg"
run/max_fps=30
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)
lights_and_shadows/use_shadow_atlas=false

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
DistrictManager="*res://scripts/systems/district_manager.gd"
VehicleManager="*res://scripts/systems/vehicle_manager.gd"
EndingManager="*res://scripts/systems/ending_manager.gd"
QualityProfiles="*res://scripts/systems/quality_profiles.gd"
SideActivityManager="*res://scripts/systems/side_activity_manager.gd"

[physics]
3d/default_gravity=18.0

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
save_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
load_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194340)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
